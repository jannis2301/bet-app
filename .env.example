MONGODB_URI=
JWT_SECRET=
JWT_LIFETIME=1d
PORT=5050
NODE_ENV=development

# optional — outbound mail for password-reset links and matchday reminders,
# sent via Resend's HTTPS API (not SMTP — Render's free tier blocks outbound
# SMTP ports entirely). Get an API key from https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=

# hard cap on emails sent per rolling 24h, across all mail types (default: 10)
DAILY_EMAIL_LIMIT=10

# receives an email for every new registration, with links to approve or
# reject it — see controllers/authController.ts's register/approveUser/rejectUser
ADMIN_EMAIL=
