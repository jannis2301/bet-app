MONGODB_URI=
JWT_SECRET=
JWT_LIFETIME=1d
PORT=5050
NODE_ENV=development

# optional — outbound mail for password-reset links and matchday reminders
# Resend's SMTP relay works out of the box here: SMTP_HOST=smtp.resend.com,
# SMTP_PORT=587, SMTP_USER=resend, SMTP_PASS=<Resend API key>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# hard cap on emails sent per rolling 24h, across all mail types (default: 10)
DAILY_EMAIL_LIMIT=10
