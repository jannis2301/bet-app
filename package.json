{
  "name": "bet-api",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "dist/server.js",
  "author": "Jannis",
  "scripts": {
    "setup-production": "pnpm run install-client && pnpm run build-client && pnpm install && pnpm run build",
    "install-client": "cd client && pnpm install",
    "build-client": "cd client && pnpm run build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "tsx watch server.ts",
    "client": "cd client && pnpm start",
    "dev": "concurrently --kill-others-on-fail \"pnpm run start\" \"pnpm run client\"",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "pnpm run test && pnpm --dir client run test"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4",
    "morgan": "^1.11.0",
    "node-cron": "^4.6.0",
    "path": "^0.12.7",
    "pdfkit": "^0.20.1",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.4.0",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "@types/validator": "^13.15.10",
    "concurrently": "^10.0.5",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.24.0"
}
